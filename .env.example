# JWT / Auth
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (local dev uses file in project root; Docker uses /app/data volume)
DATABASE_URL=sqlite:///raw_data.db

# API (leave empty when frontend is served by the same backend)
API_PORT=8000
API_BASE_URL=

# Default seed user (created on first run if missing)
DEFAULT_USER=vigas
DEFAULT_PASSWORD=123
DEFAULT_LOJA=CZ
DEFAULT_CARGO=cop tief
